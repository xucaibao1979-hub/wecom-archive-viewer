WECOM_DB_HOST=127.0.0.1
WECOM_DB_PORT=5432
WECOM_DB_NAME=archive_database
WECOM_DB_USER=viewer
WECOM_DB_PASSWORD=填写数据库密码
VIEWER_PORT=8765
VIEWER_SECRET_KEY=请替换为至少32位随机字符串
VIEWER_ADMIN_USER=admin
VIEWER_ADMIN_PASSWORD=请设置初始密码
VIEWER_USER_DB=/opt/archive-data/viewer_users.db
VIEWER_MEDIA_ROOT=填写媒体文件目录的绝对路径
VIEWER_EXPORT_IMAGE_HOSTS=media.example.com
VIEWER_SERVICE_DEPARTMENT_IDS=194
VIEWER_OFFICIAL_GROUP_KEYWORDS=官群
# 可补充未包含关键词的官群ID，多个用逗号分隔
VIEWER_OFFICIAL_GROUP_IDS=
VIEWER_CACHE_TTL_SECONDS=45
# 内部系统免密入口（正式 HTTPS 部署时启用）
VIEWER_PUBLIC_ORIGIN=https://archive.example.com
VIEWER_COOKIE_SECURE=true
