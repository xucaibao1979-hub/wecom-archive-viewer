[Unit]
Description=Conversation Archive Viewer
After=network-online.target
Wants=network-online.target

[Service]
User=archive
Group=archive
WorkingDirectory=/opt/archive-viewer
Environment=VIEWER_DATA_DIR=/opt/archive-data
ExecStart=/opt/archive-viewer/.venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8765 --timeout 120 app:app
Restart=always
RestartSec=3
UMask=0077

[Install]
WantedBy=multi-user.target
